# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Voice validation scratch output (scripts/check-voice-providers.ts)
voice-check.mp3

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# Local data — but keep seed.example.yaml committed
data/*
!data/seed.example.yaml
*.sqlite
*.sqlite-journal
*.db
.lancedb/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Greenfield /implement run artifacts (detached build logs + report).
# The design ledger docs/tdd/BLOCKERS.md is NOT ignored — it is committed.
docs/tdd/.implement-logs/

# Per-machine lefthook overrides (auto-merged by lefthook). Used by the
# strategy-side installer to add a forbidden-string pre-commit check whose
# content is intentionally kept out of the public repo.
lefthook-local.yml

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Operating system
*~
.cache/

# Belt-and-suspenders: never accidentally commit strategy materials
# (these live outside the repo by design, but in case of misconfig).
# Note: gitignore patterns are evaluated against repo-relative paths and
# don't traverse `..`, so a `../strategy/` entry would be a no-op — the
# real defense is the pre-commit hook installed by
# strategy/scripts/install-public-repo-hooks.sh.
strategy/
**/competitive-analysis.md
# A public, public-safe product requirements doc lives at docs/PRD.md (the
# greenfield workflow's PRD). Allow exactly that path; keep ignoring a stray
# PRD.md anywhere else and the private versioned PRDs (PRD-v0.x). The real
# content guard is the forbidden-string pre-commit hook, not these filename rules.
**/PRD.md
!/docs/PRD.md
**/PRD-*.md
**/task-breakdown*.md
plugins/*/pnpm-lock.yaml
local_cache/
