{
  "name": "skeinkeeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, open-source AI Dungeon Master.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/run-eval.mjs",
    "eval:live": "pnpm --filter @skeinkeeper/eval eval:live",
    "check:headers": "node scripts/check-license-headers.mjs",
    "check:telemetry-events": "node scripts/validate-telemetry-events.mjs",
    "check:voice": "tsx scripts/check-voice-providers.ts",
    "check:discord-speak": "tsx scripts/check-discord-speak.ts",
    "check:discord-listen": "tsx scripts/check-discord-listen.ts",
    "check:discord-session": "tsx scripts/check-discord-session.ts",
    "app:start": "tsx app/src/main.ts",
    "ingest:compendium": "tsx app/src/ingest.ts",
    "skeinkeeper": "tsx scripts/skeinkeeper.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@skeinkeeper/llm-anthropic": "workspace:^",
    "@skeinkeeper/memory-lance": "workspace:*",
    "@skeinkeeper/orchestrator": "workspace:^",
    "@skeinkeeper/server": "workspace:*",
    "@skeinkeeper/voice-discord": "workspace:*"
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "discord.js": "^14.16.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "lefthook": "^1.10.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
