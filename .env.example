# Skeinkeeper environment variables.
#
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# All secrets are loaded by the local server at startup and (when persisted)
# stored in the OS keyring or an AES-256-GCM-sealed config file per ADR-0010.

# -----------------------------------------------------------------------------
# Discord — bot you've registered in your own Discord developer account.
# -----------------------------------------------------------------------------
# Your bot's token (from https://discord.com/developers/applications).
DISCORD_BOT_TOKEN=

# The Discord server (guild) ID the bot operates in.
DISCORD_GUILD_ID=

# The voice channel the bot joins for the session.
DISCORD_VOICE_CHANNEL_ID=

# Optional FALLBACK for the operator who gets setup-note DMs during play (e.g.,
# a character Skeinkeeper couldn't match for a player). Prefer designating
# yourself at runtime: `/skeinkeeper operator claim` in Foundry chat, or the console
# Operator panel (pick from voice / type your @username). A runtime designation
# is persisted and overrides this. Unset everywhere = notes fall back to the log.
DISCORD_OPERATOR_USER_ID=

# -----------------------------------------------------------------------------
# Foundry VTT — your own instance. Enable the Skeinkeeper add-on shipped in
# modules/skeinkeeper. Do not install a third-party Foundry connector.
# -----------------------------------------------------------------------------
# Informational (your Foundry web URL). The add-on dials the gateway below.
FOUNDRY_URL=
# Where the gateway listens:
#   loopback  (default) 127.0.0.1 — Skeinkeeper and Foundry on the same machine.
#   container 0.0.0.0 inside a container's own network namespace, reached from
#             the host through docker-compose.yml's loopback-scoped publish
#             mapping. docker-compose.yml SETS THIS FOR YOU; leaving it here has
#             no effect on `docker compose up` (the compose `environment:` block
#             wins) and on a native run it would bind 0.0.0.0 on your host with
#             no TLS. Don't set it by hand.
#   lan       0.0.0.0 on a real network — Foundry on another machine. Requires a
#             pairing secret and FOUNDRY_GATEWAY_TLS_CERT + _TLS_KEY.
# The add-on's gateway URL is ws://127.0.0.1:7733 for loopback and container
# alike; wss://<host>:7733 for lan.
FOUNDRY_GATEWAY_BIND=loopback
FOUNDRY_GATEWAY_PORT=7733
# If unset (loopback / container): generated once, persisted to the data dir, and
# printed on the console at boot so you can pair the add-on before Start.
# Required for lan, and never blank under container — see docs/INSTALL.md.
FOUNDRY_PAIRING_SECRET=
# FOUNDRY_GATEWAY_TLS_CERT=
# FOUNDRY_GATEWAY_TLS_KEY=

# -----------------------------------------------------------------------------
# LLM provider. Anthropic Claude is the default per ADR-0004.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: model overrides. Defaults are picked by the orchestrator's
# model-tier routing (Opus-class for narration, Haiku-class for orchestration).
# ANTHROPIC_MODEL_NARRATION=
# ANTHROPIC_MODEL_ORCHESTRATION=

# -----------------------------------------------------------------------------
# Voice providers. Operator brings their own keys.
# -----------------------------------------------------------------------------
# TTS (text-to-speech). ElevenLabs is the default.
ELEVENLABS_API_KEY=

# STT (speech-to-text). Deepgram is the default; local Whisper is also supported.
DEEPGRAM_API_KEY=

# Optional: override the DM's TTS voice by provider voice ID. Normally set via
# the console's persona picker instead (you don't need a raw voice ID).
ELEVENLABS_DM_VOICE_ID=

# -----------------------------------------------------------------------------
# Secret sealing + PII encryption at rest (optional). One passphrase does two
# things: it seals the secrets above (`pnpm skeinkeeper secrets:seal`, then delete
# the plaintext lines) AND turns on per-column AES-256-GCM encryption of personal
# data — Discord IDs, display names, transcript text, audit payloads, settings
# (run `pnpm skeinkeeper pii:encrypt` once to migrate an existing database).
# The passphrase opens both at boot — export it in your shell or inject it as a
# docker/systemd secret; do NOT store it here. Unset = secrets read from .env and
# PII stored as plaintext (the alpha default). See
# docs/tdd/0029-sealed-credential-store.md and docs/tdd/0030-pii-column-encryption.md.
# -----------------------------------------------------------------------------
# SKEINKEEPER_SECRET_PASSPHRASE=

# -----------------------------------------------------------------------------
# Telemetry — off by default per ADR-0009.
# Set to "1" to opt in; any other value (including unset) keeps it off.
# Both streams require the operator's affirmative consent.
# -----------------------------------------------------------------------------
SKEINKEEPER_TELEMETRY_ANALYTICS=
SKEINKEEPER_TELEMETRY_CRASH=

# Maintainer-side destinations. Only used when the operator has opted in
# above. Get the PostHog project key from your project's Settings → General;
# the Sentry DSN from your project's Settings → Client Keys (DSN).
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Local server.
# -----------------------------------------------------------------------------
SKEINKEEPER_WEB_PORT=3000
# Bind address for the operator console. Default 127.0.0.1 (localhost only).
# Set 0.0.0.0 to expose it on your network — only if you understand the risk
# (the console can control a live session), and only with a password hash set:
# Skeinkeeper refuses to bind a non-loopback address without one.
# docker-compose.yml sets 0.0.0.0 for you (see FOUNDRY_GATEWAY_BIND above); that
# is the container's own namespace, published to your host's loopback only.
# SKEINKEEPER_WEB_HOST=127.0.0.1
SKEINKEEPER_DATA_DIR=./data

# Docker only: the uid/gid the container runs as, so files it writes into ./data
# belong to you and the erasure CLI can delete them. Defaults to 1000:1000 — set
# these if `id -u` / `id -g` say otherwise.
SKEINKEEPER_UID=1000
SKEINKEEPER_GID=1000

# Which tenant + campaign this deployment runs. Both default as shown.
SKEINKEEPER_TENANT_ID=default
SKEINKEEPER_CAMPAIGN_ID=default

# Default DM eagerness: reserved | balanced | eager. Runtime-tunable in the
# console / via slash command; this is just the startup default.
SKEINKEEPER_EAGERNESS=balanced

# Optional: require a password for the operator console. Generate a hash with:
#   pnpm tsx -e "import('@skeinkeeper/app').then(m => console.log(m.hashPassword('your-password')))"
# Unset = console is open (intended for a single-operator localhost box). Under
# FOUNDRY_GATEWAY_BIND=container the console is never open: leave this unset and
# a password is generated, saved 0600 to <data dir>/.console-password, and
# printed once on the boot that creates it. Setting it here wins over that.
SKEINKEEPER_OPERATOR_PASSWORD_HASH=

# Optional: HMAC secret for console session cookies. If unset, a random one is
# generated at startup (console logins reset on restart).
SKEINKEEPER_SESSION_SECRET=
